# 복사해서 apps/web/.env.local 로 쓰거나 Cloudflare Pages 환경변수로 넣는다. 실제 값은 커밋하지 않는다.

# 사이트 기본 (도메인 확정 후)
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=차값계산소

# 검색 노출 스위치: 도구가 공개되기 전에는 false (전 페이지 noindex + robots.txt 전체 차단)
NEXT_PUBLIC_SITE_INDEXABLE=false

# 운영자 정보 (about·contact 페이지). 비어 있으면 공개 전 점검에서 실패한다.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_EMAIL=

# 분석·광고
NEXT_PUBLIC_GA_ID=
ADSENSE_PUB_ID=

# 검색엔진 소유 확인 (메타 태그 방식을 쓸 때만)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
