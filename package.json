{
  "name": "new-site",
  "private": true,
  "description": "전기차·내 차 돈 계산소(가칭) — 웹(Next.js) + 안드로이드 앱(Capacitor) 모노레포",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:seo": "node scripts/check-seo.mjs",
    "make:og": "node scripts/make-og.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "check:quality": "node scripts/check-page-quality.mjs",
    "data:ev": "node scripts/data/import-ev-subsidy.mjs",
    "check:similarity": "node scripts/check-similarity.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "check:all": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:seo && npm run check:quality && npm run check:similarity && npm run check:launch && npm run validate:data"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
